#!/usr/bin/env sh
# ─────────────────────────────────────────────────────────────────────────
# Pre-commit hook — production-independent checks only.
#
# What runs:
#   `npm run test:security-static` — static security regression checks
#   (tests/unit/finding-e-definer-guards.test.ts). They read the repo's
#   migration files and source, never a database, need no credentials and
#   work offline. CI runs the same command (.github/workflows/ci.yml).
#
# What does NOT run here, and why:
#   `npm run test:regressions` (tests/integration/regressions.test.ts) is NOT
#   run by this hook. That suite loads .env.local and queries the database it
#   points at with the service-role key - which is production. Until
#   2026-11-02 this hook ran it on every commit, so each commit read
#   production with a secret key from the developer machine. Its assertions
#   are unchanged and it still runs on demand:
#       npm run test:regressions
#   Point it at an isolated staging project before running it; it is meant to
#   move to staging (security backlog INFRA-1). A commit passing this hook
#   says nothing about that suite - it was not executed.
#
# Escape hatch (rare): git commit --no-verify -m "..."
# ─────────────────────────────────────────────────────────────────────────

set -e

echo "→ Running static security checks (no database, no credentials)..."
echo ""

npm run test:security-static --silent

echo ""
echo "✓ Static security checks passed."
echo "  Note: the database regression suite (npm run test:regressions) was NOT run."
echo "  Proceeding with commit."
